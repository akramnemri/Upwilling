# Copy to apps/web/.env.local for local development. Never commit real values.
# Variable names only; every variable is documented here when it is introduced.
# The server validates these at startup and exits with the list of missing or invalid variables.

# Which host allowlist applies: local | recette | production (apps/web/src/modules/core/tenancy/hosts.ts).
DEPLOY_ENV=local

# Optional. fatal | error | warn | info | debug (default: info). Use debug only locally.
LOG_LEVEL=info

# Disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
