# Copy to apps/web/.env.local for local development. Never commit real values.
# Variable names only; every variable is documented here when it is introduced.
# The server validates these at startup and exits with the list of missing or invalid variables.

# Which host allowlist applies: local | recette | production (apps/web/src/modules/core/tenancy/hosts.ts).
DEPLOY_ENV=local

# Optional. fatal | error | warn | info | debug (default: info). Use debug only locally.
LOG_LEVEL=info

# Container role: web | cms | worker (01_ARCHITECTURE.md §5.3). Leave unset locally: one process then serves
# every local host. Required when DEPLOY_ENV is recette or production (the server refuses to start without it).
# APP_ROLE=

# Only with APP_ROLE=web: the one site this container serves (upwilling | careerboost). Refused for other roles.
# SITE=

# Set by the image only (Task 1.5): the commit it was built from, served by /api/version. Default: local.
# APP_VERSION=

# Disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
