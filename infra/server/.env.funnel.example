# Template for the .env of compose.funnel.yaml (C:\upwilling-server\funnel\.env on the local machine).
# Names only: a human creates the real file and never commits it. Runbook: docs/runbooks/local-server.md

# Tailscale auth key: reusable, NOT ephemeral, tag tag:upwilling-recette (runbook). Paste it here yourself, never in
# a chat. Only used the first time each device joins; afterwards it can be removed and revoked in the console.
TS_AUTHKEY=

# Basic auth in front of the public recette names (ADR-017). The hash comes from:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password
# Keep the single quotes around the hash: it contains `$`, which Compose would otherwise try to expand.
RECETTE_BASIC_AUTH_USER=
RECETTE_BASIC_AUTH_HASH=''
