# Template for /srv/upwilling-edge/.env (compose.edge.yaml). Names only: a human creates the real file
# on the server (mode 600, owner deploy) and never commits it. Runbook: docs/runbooks/compose-stacks.md

# Caddy runs as the deploy user, who owns the certificate files: the output of `id -u deploy` and `id -g deploy`.
CADDY_UID=
CADDY_GID=

# Optional. Folder with origin.pem, origin.key and origin-pull-ca.pem (default ./certs, i.e. /srv/upwilling-edge/certs).
CADDY_CERTS_DIR=

# Optional. Published port (default 443). Only the local smoke test changes it.
EDGE_HTTPS_PUBLISH=

# Basic auth in front of every recette host except recette-hooks (ADR-017, ADR-022).
# The hash comes from: docker run --rm caddy:2.11.7-alpine caddy hash-password
# Keep the single quotes around the hash: it contains `$`, which Compose would otherwise try to expand.
RECETTE_BASIC_AUTH_USER=
RECETTE_BASIC_AUTH_HASH=''
