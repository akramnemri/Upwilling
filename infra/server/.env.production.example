# Template for /srv/upwilling-prod/.env (compose.production.yaml). Names only: a human creates the real file
# on the server (mode 600, owner deploy) and never commits it. Runbook: docs/runbooks/compose-stacks.md

# Leave unset when the deploy agent runs the stack (Task 1.5b, ADR-024): it passes the exact image itself.
# Only for a start by hand: ghcr.io/akramnemri/upwilling-web:<commit SHA>.
APP_IMAGE=

# Optional: fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=

# Password of the production Postgres superuser. Generate on the server: openssl rand -hex 32
# Store it in the password manager. Changing it later needs ALTER ROLE: the image applies it only on first start.
POSTGRES_PASSWORD=

# Payload (Task 3.1b). Each one generated on the server with: openssl rand -hex 32, kept in the password manager.
# Password of the application's own role `app` (not a superuser; created and kept in sync by db-setup).
APP_DB_PASSWORD=
# Signs Payload's login tokens; changing it logs every admin out.
PAYLOAD_SECRET=

# Cloudflare R2, public media bucket (ADR-008): required, production's cms refuses to start without them.
# Created by a human in the Cloudflare dashboard (R2 API token limited to this bucket).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
