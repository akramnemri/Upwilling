# Template for /srv/upwilling-prod/.env (compose.production.yaml). Names only: a human creates the real file
# on the server (mode 600, owner deploy) and never commits it. Runbook: docs/runbooks/compose-stacks.md

# Image to run. Task 1.5's deploy workflow sets it: ghcr.io/<owner>/<repository>:<commit SHA>.
APP_IMAGE=

# Optional: fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=

# Password of the production Postgres superuser. Generate on the server: openssl rand -hex 32
# Store it in the password manager. Changing it later needs ALTER ROLE: the image applies it only on first start.
POSTGRES_PASSWORD=
