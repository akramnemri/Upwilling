# Template for /srv/upwilling-recette/.env (compose.recette.yaml). Names only: a human creates the real file
# on the server (mode 600, owner deploy) and never commits it. Runbook: docs/runbooks/compose-stacks.md

# Leave unset when the deploy agent runs the stack (Task 1.5b, ADR-024): it passes the exact image itself.
# Only for a start by hand: ghcr.io/akramnemri/upwilling-web:<commit SHA>.
APP_IMAGE=

# Optional: fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=

# Password of the recette Postgres superuser; never the production one. Generate: openssl rand -hex 32
# Changing it later needs ALTER ROLE: the image applies it only on first start.
POSTGRES_PASSWORD=
