# Template for <server folder>/backup/.env (compose.backup.yaml). Names only: a human creates the real file on the
# server (mode 600) and never commits it. Runbook: docs/runbooks/backup-restore.md

# The stack whose databases are backed up, and its Compose network:
# recette + upwilling-recette_default, or production + upwilling-prod_default.
BACKUP_STACK=recette
BACKUP_NETWORK=upwilling-recette_default

# The age PUBLIC key (age1...) backups are encrypted to. Not a secret. The private key never goes on this machine.
BACKUP_AGE_RECIPIENT=

# Where backups go: any rclone path. /backups is the local folder below. For R2 (docs/integrations/r2.md):
# r2:<bucket>, plus the RCLONE_CONFIG_R2_* variables listed there.
BACKUP_DESTINATION=/backups

# Optional: host folder mounted as /backups. Default ../backups, next to the stack folders.
BACKUP_LOCAL_DIR=

# Optional: databases to back up, separated by a space (default app; add umami with Task 5.8).
BACKUP_DATABASES=

# Optional: hours between backups (default 24), days a backup is kept (default 35, TR-08, to confirm with the PO),
# seconds between two looks at the destination (default 300).
BACKUP_INTERVAL_HOURS=
BACKUP_RETENTION_DAYS=
BACKUP_POLL_SECONDS=
