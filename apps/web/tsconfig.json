{
  "extends": "@upwilling/config/tsconfig/nextjs.json",
  "compilerOptions": {
    // Payload generates the admin import map as JavaScript (src/app/(payload)/admin/importMap.js).
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
