{
  "name": "@upwilling/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js application serving upwilling.fr and careerboost.upwilling.fr (Payload added in Milestone 3)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/bundle-entries.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@upwilling/design-system": "workspace:*",
    "lucide-react": "1.61.0",
    "next": "16.3.8",
    "pino": "9.14.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@upwilling/config": "workspace:*",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "postcss": "8.5.32",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
