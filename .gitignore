# The repository is PUBLIC. When in doubt, ignore it.

# Dependencies
node_modules/
.pnpm-store/

# Build and tool output
.next/
out/
dist/
build/
.turbo/
storybook-static/
*.tsbuildinfo
next-env.d.ts

# Tests
coverage/
playwright-report/
blob-report/
